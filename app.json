{
  "expo": {
    "name": "Planora",
    "slug": "planora",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "orientation": "portrait",
    "scheme": "planora",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F5FF",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.nahomtaye.planora",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.nahomtaye.planora",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F5FF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "locales": {
      "en": "./locales/en.json",
      "am": "./locales/am.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "ar": "./locales/ar.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5FF",
          "image": "./assets/images/splash-artwork.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0D0B1E",
            "image": "./assets/images/adaptive-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B2EE5",
          "defaultChannel": "planora-reminders"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Planora to export plan blocks you choose to a device calendar."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "am", "es", "fr", "ar"],
            "android": ["en", "am", "es", "fr", "ar"]
          },
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
