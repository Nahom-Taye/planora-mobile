{
  "expo": {
    "name": "Planora",
    "slug": "planora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "planora",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F6F2",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.nahomtaye.planora",
      "supportsTablet": true
    },
    "android": {
      "package": "com.nahomtaye.planora",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F2"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "am", "es", "fr", "ar"],
            "android": ["en", "am", "es", "fr", "ar"]
          },
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
